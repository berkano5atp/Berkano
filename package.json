{
  "name": "berkano-website",
  "private": true,
  "version": "1.0.0",
  "description": "Marketing website for Berkano, a proposed non-clinical recovery self-management app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/merriweather-sans": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/libre-bodoni": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "lucide-react": "^1.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
